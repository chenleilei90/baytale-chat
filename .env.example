# BayChat 环境配置示例
# 部署到公网服务器时请复制为 .env 并修改对应值：cp .env.example .env

# 你的访问域名（Docker + Caddy 方案请将 DNS A 记录指向服务器公网 IP 且关闭 CDN/灰云朵）
DOMAIN=chat.example.com

# 你的公网服务器 IPv4 地址（coturn NAT 穿透与中转必需！）
PUBLIC_IP=1.2.3.4

# STUN/TURN 服务域名（若主域名走了 Cloudflare 橙色云，请单独建灰云子域名 turn.example.com）
TURN_HOST=chat.example.com

# TURN 动态凭证共享密钥（务必修改为随机长字符串，可用 openssl rand -hex 32 生成）
TURN_SECRET=please-change-this-to-a-strong-random-secret-key

# TURN 端口配置（默认 UDP/TCP 3478；若未为 coturn 挂载 TLS 证书，TURN_TLS_PORT 保持 0 即可）
TURN_PORT=3478
TURN_TLS_PORT=0

# TURN 中继 UDP 端口范围（请在服务器防火墙放行 UDP 49152-49300）
TURN_MIN_PORT=49152
TURN_MAX_PORT=49300

# 单个房间最大成员数上限（2~12，默认 6）
MAX_ROOM_PEERS=6

# 单文件附件大小限制配置（单位：MB）
# MAX_ATTACHMENT_MB：服务端允许的最高硬上限（0 表示不限制，房间内可自由调整）
# DEFAULT_ROOM_MAX_FILE_MB：新建房间默认的单文件附件上限（0 表示不限制，默认 500）
# HISTORY_MAX_MEDIA_MB：服务端缓存聊天图片/语音单文件上限（1~100，默认 10）
MAX_ATTACHMENT_MB=0
DEFAULT_ROOM_MAX_FILE_MB=500
HISTORY_MAX_MEDIA_MB=10

# 允许的来源（留空默认允许所有；生产环境可设为 https://chat.example.com）
ALLOWED_ORIGIN=
