<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础网络与状态检测权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 允许申请系统电池优化白名单，避免国产机型切后台冻结网络与断流 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 前台保活传输服务与 Android 13+ 通知权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 语音对讲消息录制（按需在用户长按/点击录音时请求） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 相机仅用于主动扫描房间二维码与拍照直发（设为非必需以兼容平板等无相机设备） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 9 及以下写入公共目录需要；Android 10+ 走 MediaStore 零存储权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 仅用于用户主动点击「应用内检查更新」后调起系统包安装器覆盖升级 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 剔除 JPush SDK 自动合并的定位/设备号/全应用读取等非必需敏感权限，保持最小权限原则 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />

    <application
        android:name=".BayChatApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BayChat"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <!-- 桌面启动入口 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 接收系统「分享到 BayChat」单文件/图片/文本 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- 接收系统「分享到 BayChat」多文件/多图 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- 深链：点击 chat.baytale.com 房间邀请链接直接唤起原生 App -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="chat.baytale.com" />
                <data android:path="/" />
                <data android:pathPrefix="/r/" />
            </intent-filter>

            <!-- 自定义协议唤起：baychat://room/<code> 与桌面长按快捷方式 baychat://action/* -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="baychat" android:host="room" />
                <data android:scheme="baychat" android:host="action" />
            </intent-filter>

            <!-- 桌面长按静态快捷方式（快传 / 扫码 / 取件码） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 竖屏锁定的扫码 Activity（替代 ZXing 默认横屏） -->
        <activity
            android:name=".ui.PortraitCaptureActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- 前台保活传输服务：切后台/锁屏时保持 WebSocket 与 P2P 大文件传输不断线 -->
        <service
            android:name=".service.TransferForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 企业级 OTA 应用自动更新前台服务：支持断点续传、切后台保活与通知栏暂停/继续 -->
        <service
            android:name=".service.AppUpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 后台高优先级来件通知「接收 / 拒绝」快捷操作接收器 -->
        <receiver
            android:name=".service.IncomingActionReceiver"
            android:exported="false" />

        <!-- 极光全机型系统级离线推送后台核心服务与消息回调接收器 -->
        <service
            android:name=".core.push.BayPushService"
            android:enabled="true"
            android:exported="false"
            android:process=":pushcore">
            <intent-filter>
                <action android:name="cn.jiguang.user.service.action" />
            </intent-filter>
        </service>

        <service
            android:name=".core.push.BayPushReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="cn.jpush.android.intent.SERVICE_MESSAGE" />
                <category android:name="${applicationId}" />
            </intent-filter>
        </service>

        <!-- 安全打开本地下载文件的 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
