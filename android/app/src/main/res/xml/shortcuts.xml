<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_send"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_quick_send_short"
        android:shortcutLongLabel="@string/shortcut_quick_send_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="baychat://action/quick_send"
            android:targetClass="com.baytale.baychat.MainActivity"
            android:targetPackage="com.baytale.baychat" />
    </shortcut>

    <shortcut
        android:shortcutId="scan"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_scan_short"
        android:shortcutLongLabel="@string/shortcut_scan_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="baychat://action/scan"
            android:targetClass="com.baytale.baychat.MainActivity"
            android:targetPackage="com.baytale.baychat" />
    </shortcut>

    <shortcut
        android:shortcutId="pickup"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_pickup_short"
        android:shortcutLongLabel="@string/shortcut_pickup_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="baychat://action/pickup"
            android:targetClass="com.baytale.baychat.MainActivity"
            android:targetPackage="com.baytale.baychat" />
    </shortcut>
</shortcuts>
